{
	"devices": [
		{
			"id": "Virt",
			"type": "vrack2-net.ConverterVirtual",
			"options": {
				"host": "127.0.0.1",
				"port": 15051,
				"timeout": 0
			},
			"connections": [
				"Virt.buffer -> Slave.buffer"
			]
		},
		{
			"id": "Slave",
			"type": "vrack2-modbus.ModbusRTUSlave",
